<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止明文 HTTP：余额接口与更新下载必须走 HTTPS。
         自建 HTTP 汇率地址会被拦下，这是有意的安全取舍。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
