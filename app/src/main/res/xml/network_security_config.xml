<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认仍由代码强制 HTTPS；仅调试开关下的汇率请求允许明文，其他接口不允许 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
