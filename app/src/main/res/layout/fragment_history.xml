<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        android:background="@color/surface"
        android:elevation="2dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="返回"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/str_027"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_export"
                android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导出"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="false" />
        <TextView
            android:id="@+id/btn_clear"
                android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_080"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="false" />
            <TextView
            android:id="@+id/btn_dedupe"
                android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hist_dedupe"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="false" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 筛选栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btn_filter_provider"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:gravity="center"
                    android:text="@string/str_081"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_gradient_button"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/btn_filter_time"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:gravity="center"
                    android:text="@string/str_082"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_input_field"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>

            <!-- 月度统计 -->
            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_stats_rounded"
                android:padding="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 趋势图 -->
            <asia.rxh.apibalance.TrendChartView
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/card_bg"
                android:padding="8dp" />

            <!-- 月度柱状图 -->
            <asia.rxh.apibalance.TrendBarChartView
                android:id="@+id/month_bar_chart"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                android:background="@color/card_bg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_trend_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/str_083"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:padding="16dp" />

            <!-- 历史列表标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/str_084"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
