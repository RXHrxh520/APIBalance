<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:padding="20dp">

    <ImageView android:layout_width="64dp" android:layout_height="64dp"
        android:layout_marginTop="12dp" android:src="@drawable/ic_app_logo"
        android:scaleType="fitCenter" android:contentDescription="@string/lock_enter" />

    <TextView android:id="@+id/tv_lock_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:gravity="center" android:text="@string/lock_enter"
        android:textColor="@color/text_primary" android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout android:id="@+id/dot_row" android:layout_width="wrap_content"
        android:layout_height="18dp" android:layout_marginTop="14dp"
        android:gravity="center" android:orientation="horizontal" />

    <TextView android:id="@+id/tv_lock_error" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#FFEF4444" android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout android:layout_width="272dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_key_1"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="1" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_2"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="2" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_3"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="3" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_key_4"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="4" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_5"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="5" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_6"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="6" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_key_7"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="7" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_8"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="8" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_9"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="9" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_key_del"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="⌫" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_0"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="0" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:clickable="true"
                    android:focusable="false" />
                <TextView android:id="@+id/btn_key_ok"
                    android:layout_width="0dp" android:layout_height="54dp"
                    android:layout_weight="1" android:layout_margin="5dp"
                    android:background="@drawable/bg_keypad_key" android:gravity="center"
                    android:text="确定" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tv_lock_finger" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:padding="10dp" android:text="@string/lock_fp_start"
        android:textColor="@color/primary" android:textSize="14sp"
        android:clickable="true" android:focusable="false" />
    <TextView android:id="@+id/tv_forgot" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:padding="10dp"
        android:text="@string/lock_forgot" android:textColor="@color/text_hint"
        android:textSize="13sp" android:clickable="true" android:focusable="false" />
</LinearLayout>
</ScrollView>
