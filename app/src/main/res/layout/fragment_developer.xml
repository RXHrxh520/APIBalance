<?xml version="1.0" encoding="utf-8"?>
<!--
  开发人员页面（v1.5 改版）
  结构参考主流大厂 App 的「关于/团队」页：
    1) 顶栏 + 返回
    2) 头图卡片（粉色渐变 + 圆形头像 + 姓名/角色 + GitHub 徽标）
    3) 相关链接分组（GitHub 主页 / 项目仓库 / 交流群）
    4) 作者简介分组
    5) 头像来源说明
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_surface">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingLeft="8dp" android:paddingRight="16dp">
        <ImageView android:id="@+id/btn_dev_back" android:layout_width="48dp"
            android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_arrow_back" android:clickable="true"
            android:focusable="false" android:contentDescription="@string/h_004"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/mine_developers"
            android:textColor="@color/text_primary" android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="16dp"
            android:paddingRight="16dp" android:paddingBottom="32dp">

            <!-- 头图卡片 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="150dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_card_balance">
                <ImageView android:id="@+id/iv_dev_bg" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop"
                    android:src="@drawable/bg_dev_pink"
                    android:contentDescription="@string/mine_developers" />
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="bottom"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView android:id="@+id/iv_dev_avatar" android:layout_width="64dp"
                        android:layout_height="64dp" android:background="@drawable/bg_avatar_ring"
                        android:scaleType="centerCrop" android:src="@drawable/ic_dev_avatar"
                        android:contentDescription="@string/dev_name" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginLeft="14dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_dev_name" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/dev_name"
                            android:textColor="@color/text_primary" android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/tv_dev_role" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="@string/dev_role" android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView android:id="@+id/tv_dev_avatar_from"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/dev_avatar_from"
                android:textColor="@color/text_secondary" android:textSize="11sp" />

            <!-- 相关链接 -->
            <TextView android:id="@+id/tv_dev_links_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
                android:text="@string/dev_links" android:textColor="@color/text_primary"
                android:textSize="15sp" android:textStyle="bold" />

            <LinearLayout android:id="@+id/row_github" android:layout_width="match_parent"
                android:layout_height="58dp" android:background="@drawable/bg_card_balance"
                android:foreground="@drawable/bg_ripple_24" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingLeft="16dp"
                android:paddingRight="16dp" android:clickable="true" android:focusable="false">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_github" android:contentDescription="@string/dev_github" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp"
                    android:text="@string/dev_github" android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="@string/dev_github" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_repo" android:layout_width="match_parent"
                android:layout_height="58dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_balance" android:foreground="@drawable/bg_ripple_24"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:clickable="true" android:focusable="false">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_repo" android:contentDescription="@string/dev_repo" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp"
                    android:text="@string/dev_repo" android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="@string/dev_repo" />
            </LinearLayout>

            <LinearLayout android:id="@+id/tv_dev_qq" android:layout_width="match_parent"
                android:layout_height="58dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_balance" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingLeft="16dp"
                android:paddingRight="16dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_qq" android:contentDescription="@string/mine_developer_qq" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp"
                    android:text="@string/mine_developer_qq" android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 简介 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
                android:text="@string/dev_intro_title" android:textColor="@color/text_primary"
                android:textSize="15sp" android:textStyle="bold" />

            <TextView android:id="@+id/tv_dev_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card_balance"
                android:padding="16dp" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:lineSpacingExtra="5dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
